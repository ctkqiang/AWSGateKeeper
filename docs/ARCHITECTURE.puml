@startuml
!theme mars

title AWSGateKeeper — System Architecture

skinparam package {
    BackgroundColor #1A1A2E
    BorderColor #00D2FF
    FontColor #E0E0E0
}

left to right direction

actor "Security Operator" as op

rectangle "AWS Cloud — ap-east-1" as aws {
    rectangle "API Gateway\nREST / HTTP / URL" as api
    rectangle "Lambda\nAWSGateKeeper\nGo 1.26\nprovided.al2023" as lambda

    rectangle "GuardDuty\nThreat Detection" as gd
    rectangle "Inspector\nContainer CVE Scan" as insp
    rectangle "Detective / CT\nRoot Cause Analysis" as det
    rectangle "IAM\nRole + Policy" as iam_role
    rectangle "Cognito\nUser Pool Audit" as cog
    rectangle "S3\nAudit Log + Trail" as s3
    rectangle "EventBridge\nEvent Bus" as eb
    rectangle "CloudWatch\nLogs + Metrics" as cw
}

rectangle "External SIEM\nSplunk / Datadog" as siem

op --> api : HTTP requests
api --> lambda : proxy events
lambda --> gd : ListFindings + GetFindings
lambda --> insp : ListFindings
lambda --> det : CloudTrail LookupEvents
lambda --> iam_role : CreateRole + PutPolicy + UpdateAccessKey
lambda --> cog : AdminListGroupsForUser
lambda --> s3 : PutObject (audit logs)
lambda --> eb : PutEvents
lambda --> cw : stdout logs
eb --> siem : JSON events (fire-and-forget)
s3 --> siem : security reports

note right of lambda
  **Dual-mode execution**
  Lambda (API Gateway) or
  Local HTTP :8000
end note

@enduml

