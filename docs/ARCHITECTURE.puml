main_entry --> Initialize
main_entry --> ServeLambdaEndpoint

ServeLambdaEndpoint --> SecurityScanHandler
ServeLambdaEndpoint --> SecurityHealthHandler

SecurityScanHandler --> ExecuteScanAndDeliver
ExecuteScanAndDeliver --> ScanOrchestrator
ScanOrchestrator --> GuardDutyClient
ScanOrchestrator --> InspectorClient
ScanOrchestrator --> DetectiveClient
ScanOrchestrator --> BuildReport

BuildReport --> SendToMessagingEndpoint
BuildReport --> SaveReportToS3
BuildReport --> SaveReportToDynamoDB

GuardDutyClient --> AuditWildcardPolicy
GuardDutyClient --> LogFailedAction

LogFailedAction --> WriteAuditEvent
WriteAuditEvent --> Send

Initialize --> AWSCredentials
Initialize --> GetAccount

@enduml

@startuml
!theme mars

title AWSGateKeeper — Layered Architecture

rectangle "Transport Layer" as transport {
    [API Gateway Proxy] as agw
    [HTTP Server :8000] as http
    [HandleAPIGatewayEvent] as hage
}

rectangle "Route Layer" as route {
    [GET /] as r_index
    [GET /health] as r_health
    [POST /security/scan] as r_scan
    [GET /security/health] as r_security_health
}

rectangle "Service Layer" as service {
    [Security Orchestrator] as sec_orch
    [IAM Role Governance] as iam_gov
    [CloudTrail Lookup] as ct_lookup
    [SIEM Forwarder] as siem_fwd
    [Audit Logger] as audit_log
    [Wildcard Monitor] as wild_mon
}

rectangle "AWS Integration Layer" as aws_int {
    [GuardDuty Client] as gd_client
    [Inspector Client] as insp_client
    [IAM Client] as iam_client
    [S3 Client] as s3_client
    [STS Client] as sts_client
}

rectangle "Infrastructure Layer" as infra {
    [YAML Config Loader] as yaml_cfg
    [Structured Logger] as struct_log
}

transport --> route : dispatch
route --> service : invoke
service --> aws_int : AWS API calls
transport --> infra : init-time
service --> infra : runtime

@enduml
